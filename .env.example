# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted (e.g. https://cyber-crypt.onrender.com).
APP_URL="MY_APP_URL"

# PORT: HTTP + WebSocket port (Render injects PORT automatically).
PORT=3000

# NODE_ENV: Set to "production" on Render.com to serve compiled /dist assets.
NODE_ENV=production

# CLOUD_SAVE_SECRET: 32+ byte secret used for AES-256-GCM encrypted cloud saves.
CLOUD_SAVE_SECRET="CHANGE_ME_TO_A_RANDOM_64_HEX_SECRET"

# DATABASE_URL: Neon Postgres pooled connection string (accounts, saves, leaderboard).
# If unset the server falls back to the local data/db.json file (dev only; lost on redeploy).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
